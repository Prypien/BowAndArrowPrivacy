{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/game/**",
              "ui_kits/game/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:VT323|Press Start 2P))/i]",
        "message": "Font not provided by the design system. Available: VT323, Press Start 2P."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|style|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: variant, size, icon, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:gold|stone|sapphire|success|warning|danger|bronze|silver|epic)$/]",
        "message": "<Badge> variant must be one of 'gold' | 'stone' | 'sapphire' | 'success' | 'warning' | 'danger' | 'bronze' | 'silver' | 'epic'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Badge> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|full|disabled|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, full, disabled, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|danger|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'danger' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CurrencyLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:amount|currency|affordable|size|iconSrc|style|key|ref|className|style|children)$/]",
        "message": "<CurrencyLabel> doesn't accept that prop. Declared props: amount, currency, affordable, size, iconSrc, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CurrencyLabel'] > JSXAttribute[name.name='currency'] > Literal[value!=/^(?:gold|mana)$/]",
        "message": "<CurrencyLabel> currency must be one of 'gold' | 'mana'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CurrencyLabel'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<CurrencyLabel> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|icon|variant|inset|style|bodyStyle|children|key|ref|className|style|children)$/]",
        "message": "<Panel> doesn't accept that prop. Declared props: title, icon, variant, inset, style, bodyStyle, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|plain|legendary)$/]",
        "message": "<Panel> variant must be one of 'default' | 'plain' | 'legendary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|max|variant|segments|height|label|style|key|ref|className|style|children)$/]",
        "message": "<ProgressBar> doesn't accept that prop. Declared props: value, max, variant, segments, height, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:gold|mana|health|poison|xp)$/]",
        "message": "<ProgressBar> variant must be one of 'gold' | 'mana' | 'health' | 'poison' | 'xp'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ResourceCounter'] > JSXAttribute > JSXIdentifier[name!=/^(?:amount|iconSrc|glyph|tint|showAdd|onAdd|size|style|key|ref|className|style|children)$/]",
        "message": "<ResourceCounter> doesn't accept that prop. Declared props: amount, iconSrc, glyph, tint, showAdd, onAdd, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ResourceCounter'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<ResourceCounter> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|icon|key|ref|className|style|children)$/]",
        "message": "<SegmentOption> doesn't accept that prop. Declared props: value, label, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatUpgradeRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|name|level|maxLevel|cost|currency|affordable|maxed|costIconSrc|onUpgrade|style|key|ref|className|style|children)$/]",
        "message": "<StatUpgradeRow> doesn't accept that prop. Declared props: icon, name, level, maxLevel, cost, currency, affordable, maxed, costIconSrc, onUpgrade, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatUpgradeRow'] > JSXAttribute[name.name='currency'] > Literal[value!=/^(?:gold|mana)$/]",
        "message": "<StatUpgradeRow> currency must be one of 'gold' | 'mana'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
